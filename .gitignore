# ============================================================
# JavaProjects 仓库根 .gitignore
# 作用：挡住编译产物、IDE 配置、构建输出、大媒体文件与系统垃圾文件。
# 说明：本文件只影响“之后是否被跟踪”，不会自动取消已经被 git 跟踪的文件。
#       若某文件早已被提交，需要额外执行 git rm --cached 才会真正不再跟踪。
# ============================================================

# ------------------------------------------------------------
# 1. Java 编译产物
#    .class / .jar / .war 等都是 javac 编译或打包生成的结果，
#    源码（.java）才是需要版本管理的内容。
# ------------------------------------------------------------
*.class
*.jar
*.war
*.ear

# ------------------------------------------------------------
# 2. IDE 配置目录（IntelliJ IDEA）
#    .idea/ 里是每个模块的个人/机器相关配置，.iml 是模块描述文件，
#    这些由 IDEA 自动生成，不同人机器上不一致，不应提交。
# ------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws

# ------------------------------------------------------------
# 3. 构建输出目录
#    out/ 是 IDEA 默认的编译输出目录（本仓库各章节均使用它）；
#    build/、target/ 分别对应 Gradle 与 Maven 的输出目录。
#    这些目录里全是可重新生成的产物，体积大且无版本价值。
# ------------------------------------------------------------
out/
build/
target/
bin/

# ------------------------------------------------------------
# 4. 大媒体文件
#    音频、视频、压缩包体积大，尤其 .flac 单个可接近 200MB，
#    不应进入 git 历史（会让仓库迅速膨胀且无法轻易瘦身）。
#    注意：chapter20/src/111.wav 是示例音效且已被跟踪，
#          仅加此规则不会把它从历史中移除。
# ------------------------------------------------------------
*.wav
*.flac
*.mp3
*.mp4
*.avi
*.mkv
*.zip
*.rar
*.7z

# ------------------------------------------------------------
# 5. 操作系统 / 编辑器垃圾文件
#    macOS 的 .DS_Store、Windows 的 Thumbs.db，以及编辑器
#    产生的临时文件，都与项目代码无关。
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
*.swo
*.tmp
*.log
hs_err_pid*.log

# ------------------------------------------------------------
# 6. 团队协作中间产物（本仓库文档整理任务使用）
#    .agent-teams/ 是本地协作状态目录，不属于学习代码。
# ------------------------------------------------------------
.agent-teams/

# ------------------------------------------------------------
# 7. 本地记忆目录（OpenViking 画像 / 上下文）
#    .openviking/ 是本机 agent 的记忆文件，只对本机有意义，
#    不进入远程仓库。
# ------------------------------------------------------------
.openviking/
